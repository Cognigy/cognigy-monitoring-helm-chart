    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "End-to-end prompt and stream request latency percentiles by operation, provider, and model",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Duration (s)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 18 },
      "id": 202,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_gateway_request_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\", status=\"success\"}[5m])) by (le, operation, provider, model))",
          "legendFormat": "p50 {{operation}} / {{provider}} / {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_gateway_request_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\", status=\"success\"}[5m])) by (le, operation, provider, model))",
          "legendFormat": "p95 {{operation}} / {{provider}} / {{model}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(llm_gateway_request_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\", status=\"success\"}[5m])) by (le, operation, provider, model))",
          "legendFormat": "p99 {{operation}} / {{provider}} / {{model}}",
          "refId": "C"
        }
      ],
      "title": "Request Latency by Operation, Provider & Model (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Input and output token throughput for prompt and stream operations broken down by provider and model",
      "fieldConfig": {
