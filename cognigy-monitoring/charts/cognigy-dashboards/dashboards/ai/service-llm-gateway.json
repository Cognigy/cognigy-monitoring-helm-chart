        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 113,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\"service-llm-gateway.*\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Event Loop Lag p99 per Replica",
      "type": "timeseries"
    },
    {
