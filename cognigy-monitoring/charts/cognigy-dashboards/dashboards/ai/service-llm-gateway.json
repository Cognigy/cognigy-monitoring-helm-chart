      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 205,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_gateway_output_tokens_total{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\"}[5m])) by (provider, model) / sum(rate(llm_gateway_input_tokens_total{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\"}[5m])) by (provider, model)",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "title": "Output/Input Token Ratio by Provider & Model",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Reasoning token throughput by provider and model — non-zero only for models that expose chain-of-thought token counts",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "tokens/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
