        "legend": { "calcs": ["sum", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(increase(llm_gateway_requests_total{cluster=\"$cluster\", namespace=\"$namespace\", operation=~\"prompt|stream\"}[5m])) by (provider, model, status)",
