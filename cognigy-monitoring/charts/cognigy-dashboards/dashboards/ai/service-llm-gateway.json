          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 112,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\"service-llm-gateway.*\", container!=\"\", container!=\"POD\"}) by (pod)",
          "legendFormat": "usage / {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(kube_pod_container_resource_requests{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\"service-llm-gateway.*\", resource=\"memory\", unit=\"byte\"}) by (pod)",
          "legendFormat": "request / {{pod}}",
          "refId": "B"
        },
        {
          "expr": "sum(kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\"service-llm-gateway.*\", resource=\"memory\", unit=\"byte\"}) by (pod)",
          "legendFormat": "limit / {{pod}}",
          "refId": "C"
        }
      ],
      "title": "Memory Usage vs Request/Limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Node.js event loop lag p99 — high values indicate CPU starvation or blocking code",
