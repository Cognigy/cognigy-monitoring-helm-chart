      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Organisations by total LLM request volume, broken down by provider and model",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "align": "auto",
              "cellOptions": { "type": "auto" },
              "inspect": false
            },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Requests" },
              "properties": [
                { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
                { "id": "unit", "value": "short" }
              ]
            }
          ]
        },
        "gridPos": { "h": 12, "w": 12, "x": 12, "y": 30 },
        "id": 11,
        "options": {
          "cellHeight": "sm",
          "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "Requests" }]
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "editorMode": "code",
            "exemplar": false,
            "expr": "topk(50, sum by (organisationId, provider, modelType) (last_over_time(llm:requests:by_org_provider_model:increase_7d{cluster=~\"$cluster\"}[2h])))",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "A"
          },
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "editorMode": "code",
            "exemplar": false,
            "expr": "group by (organisationId, organisationName) (cognigy_ai_flow_execution_processing_time_count{cluster=~\"$cluster\"})",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "B",
            "hide": false
          }
        ],
        "title": "Organisations by Traffic per Model",
        "transformations": [
          {
            "id": "joinByField",
            "options": {
              "byField": "organisationId",
              "mode": "outer"
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time #A": true, "Time #B": true, "__name__": true, "Value #B": true },
              "indexByName": {
                "organisationId": 0,
                "organisationName": 1,
                "provider": 2,
                "modelType": 3,
                "Value #A": 4
              },
              "renameByName": {
                "organisationId": "Organisation",
                "organisationName": "Organisation Name",
                "provider": "Provider",
                "modelType": "Model",
                "Value #A": "Requests"
              }
            }
          }
        ],
        "type": "table"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Maximum traffic share held by a single organisation for each model. A value of 100% means a single customer dominates that model's usage.",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "custom": {
              "align": "auto",
              "cellOptions": { "type": "auto" },
              "inspect": false
            },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Max Share" },
              "properties": [
                { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
                { "id": "unit", "value": "percent" },
                { "id": "decimals", "value": 1 },
                { "id": "max", "value": 100 },
                { "id": "min", "value": 0 },
                { "id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 50 },
                    { "color": "orange", "value": 75 },
                    { "color": "red", "value": 90 }
                  ]
                }}
              ]
            }
          ]
        },
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
        "id": 12,
        "options": {
          "cellHeight": "sm",
          "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "Max Share" }]
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "editorMode": "code",
            "exemplar": false,
            "expr": "sort_desc(max by (provider, modelType) (last_over_time(llm:requests:org_traffic_share:ratio_7d{cluster=~\"$cluster\"}[2h])) * 100)",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Traffic Concentration - Max Single-Org Share per Model",
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true },
              "indexByName": {
                "provider": 0,
                "modelType": 1,
                "Value": 2
              },
              "renameByName": {
                "provider": "Provider",
                "modelType": "Model",
                "Value": "Max Share"
              }
            }
          }
        ],
        "type": "table"
      },
