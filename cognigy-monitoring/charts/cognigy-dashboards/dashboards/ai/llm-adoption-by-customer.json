    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total LLM request volume per provider and model over the last 7 days",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue" },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 100000 }
            ]
