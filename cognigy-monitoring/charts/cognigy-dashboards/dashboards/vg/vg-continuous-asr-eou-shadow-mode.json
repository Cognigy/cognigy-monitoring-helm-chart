        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(increase(vg_vad_eou_shadow_turn_total{cluster=\"$cluster\",outcome=\"both\"}[$__range])) / clamp_min(sum(increase(vg_vad_eou_shadow_turn_total{cluster=\"$cluster\",outcome=~\"both|real_only\"}[$__range])), 1)",
          "refId": "A",
          "range": false,
          "instant": true
