    {
      "id": 9,
      "type": "row",
      "title": "\ud83d\udd2c Go runtime \u2014 heap, GC & goroutines",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
