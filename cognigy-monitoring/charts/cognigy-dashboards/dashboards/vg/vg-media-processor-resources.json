    {
      "id": 2,
      "type": "timeseries",
      "title": "Container Memory (Working Set) per Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Working set = memory the kernel cannot reclaim under pressure \u2014 what the OOM killer watches. A steady, unbroken climb is the leak signature; a climb that plateaus and tracks STT/TTS session count is load, not a leak.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{cluster=\"$cluster\", namespace=\"$namespace\", container=\"media-processor\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
